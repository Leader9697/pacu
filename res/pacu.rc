#include <winuser.h>
1 RT_MANIFEST "pacu.manifest"
1 ICON "pacu.ico"
1 VERSIONINFO
FILEVERSION @VC@,0
PRODUCTVERSION @VC@,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Pacu - booster gaming"
      VALUE "ProductName", "Pacu"
      VALUE "FileVersion", "@V@"
      VALUE "ProductVersion", "@V@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
